{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "norvane-demo",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // nodejs_compat: agents/mcp/server uses AsyncLocalStorage.
  // global_fetch_strictly_public: required for Client ID Metadata Document lookups.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Custom domain. The zone is in the same Cloudflare account, so deploy creates DNS and certificates.
  // www is attached only so the Worker can redirect it to the apex domain.
  "routes": [
    { "pattern": "norvane-heating.com", "custom_domain": true },
    { "pattern": "www.norvane-heating.com", "custom_domain": true }
  ],
  // Local development answers as localhost rather than pretending to be the custom domain.
  "dev": { "host": "localhost:8787", "upstream_protocol": "http", "port": 8787 },
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "kv_namespaces": [
    // OAuth clients, grants and tokens. No ID: wrangler creates the namespace on the first deploy.
    { "binding": "OAUTH_KV" }
  ],
  // Exact counter for sign-in attempts (portal form and OAuth verification form), per IP address.
  "durable_objects": { "bindings": [{ "name": "LOGIN_GUARD", "class_name": "LoginGuard" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LoginGuard"] }],
  // Approximate usage caps. These are eventually consistent across Cloudflare's servers.
  "ratelimits": [
    // MCP calls and WebMCP tool calls, per IP address.
    { "name": "MCP_LIMITER", "namespace_id": "4101", "simple": { "limit": 60, "period": 60 } },
    // OAuth client registration, authorisation page and token endpoint, per IP address.
    { "name": "OAUTH_LIMITER", "namespace_id": "4103", "simple": { "limit": 20, "period": 60 } }
  ],
  "vars": {
    // Optional. Forces a canonical public origin (no trailing slash). Left empty, the Worker uses
    // the origin of each request, so localhost, workers.dev and a custom domain all just work.
    "PUBLIC_URL": "",
    // Chrome origin trial token for WebMCP. Empty until the trial is registered.
    "WEBMCP_OT_TOKEN": ""
  }
  // Secret (not stored here): COOKIE_SECRET. Set with: npx wrangler secret put COOKIE_SECRET
}
